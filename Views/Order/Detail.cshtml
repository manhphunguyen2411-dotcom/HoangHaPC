@model Order?
@{ ViewData["Title"] = "Chi tiết đơn hàng"; var placed = ViewBag.Placed as bool? == true; }

@if (Model is null)
{
    <h1>Tra cứu đơn hàng</h1>
    <form method="get" class="box lookup" onsubmit="this.action='/don-hang/' + encodeURIComponent(this.code.value)">
        <div class="field"><label>Mã đơn hàng</label><input name="code" required /></div>
        <div class="field"><label>Số điện thoại đặt hàng</label><input name="phone" required inputmode="tel" /></div>
        <button class="btn" type="submit">Tra cứu</button>
    </form>
}
else
{
    @if (placed)
    {
        <div class="alert ok">Đặt hàng thành công. Hoàng Hà PC sẽ gọi xác nhận đơn trong thời gian sớm nhất.</div>
    }
    <h1>Đơn hàng @Model.Code</h1>
    <div class="checkout">
        <div class="box">
            <table class="lines">
                <thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>SL</th><th>Thành tiền</th></tr></thead>
                <tbody>
                @foreach (var i in Model.Items)
                {
                    <tr><td>@i.ProductName</td><td>@Fmt.Vnd(i.UnitPrice)</td><td>@i.Quantity</td><td><b>@Fmt.Vnd(i.LineTotal)</b></td></tr>
                }
                </tbody>
            </table>
            <div class="total-row"><span>Tổng cộng</span><span class="price">@Fmt.Vnd(Model.Total)</span></div>
        </div>
        <aside class="box summary">
            <h2>Thông tin nhận hàng</h2>
            <p><b>@Model.CustomerName</b><br />@Model.Phone<br />@Model.Address</p>
            @if (!string.IsNullOrWhiteSpace(Model.Note)) { <p>Ghi chú: @Model.Note</p> }
            <p>Thanh toán: @Model.PaymentMethod</p>
            <p>Ngày đặt: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
            <p>Trạng thái: <span class="tag">@Model.Status</span></p>
        </aside>
    </div>
}
